{
  "name": "webext-typings-generator",
  "version": "0.1.0",
  "description": "Generates TypeScript typings from Thunderbird's annotated WebExtension API schemas",
  "main": "dist/index.js",
  "bin": {
    "generate-webext-typings": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thunderbird/webext-typings-generator.git"
  },
  "bugs": {
    "url": "https://github.com/thunderbird/webext-typings-generator/issues"
  },
  "homepage": "https://github.com/thunderbird/webext-typings-generator#readme",
  "keywords": [
    "thunderbird",
    "webextension",
    "typescript",
    "typings",
    "messenger"
  ],
  "scripts": {
    "start": "npm run build && node dist/cli.js",
    "start:ts": "ts-node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "author": "Thunderbird",
  "contributors": [
    "Arnd Issler <email@arndissler.net> (original author)"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
